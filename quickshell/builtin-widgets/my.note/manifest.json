{
  "schema": 1,
  "id": "my.note",
  "name": "Заметка",
  "description": "Короткая заметка на рабочем столе",
  "version": "1.0.0",
  "author": "built-in",
  "icon": "description",
  "entry": "Main.qml",
  "size": {
    "min": "1x1",
    "max": "3x4",
    "default": "2x2"
  },
  "settings": [
    {
      "key": "text",
      "type": "string",
      "label": "Текст",
      "default": "Заметка"
    },
    {
      "key": "align",
      "type": "enum",
      "label": "Выравнивание",
      "options": [
        "left",
        "center"
      ],
      "default": "left"
    },
    {
      "key": "accent",
      "type": "bool",
      "label": "Выделить",
      "default": false
    }
  ],
  "i18n": {
    "en": {
      "name": "Note",
      "description": "A short note on the desktop",
      "settings": {
        "text": {
          "label": "Text"
        },
        "align": {
          "label": "Alignment",
          "options": {
            "left": "Left",
            "center": "Center"
          }
        },
        "accent": {
          "label": "Highlight"
        }
      }
    }
  }
}
